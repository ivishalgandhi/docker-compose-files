# Port to expose code-server on
PORT=8080

# Ollama port (for local LLMs)
OLLAMA_PORT=11434

# Password for accessing code-server (leave empty to disable)
PASSWORD=changeme

# User ID and Group ID (match your host user for proper file permissions)
PUID=1000
PGID=1000

# Timezone
TZ=America/New_York

# Gemini API Key (optional - for using Gemini CLI)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# Extensions to install (comma-separated list of extension IDs)
# You can find extension IDs from VS Code marketplace URLs or by running:
# code --list-extensions (on your local VS Code)
EXTENSIONS=ms-python.python,ms-vscode.cpptools,eamodio.gitlens,esbenp.prettier-vscode,dbaeumer.vscode-eslint,ms-azuretools.vscode-docker,golang.go,rust-lang.rust-analyzer,GitHub.copilot

# Example of commonly used extensions:
# Python: ms-python.python, ms-python.vscode-pylance
# JavaScript/TypeScript: dbaeumer.vscode-eslint, esbenp.prettier-vscode
# Docker: ms-azuretools.vscode-docker
# Git: eamodio.gitlens
# Go: golang.go
# Rust: rust-lang.rust-analyzer
# C/C++: ms-vscode.cpptools
# GitHub Copilot: GitHub.copilot
