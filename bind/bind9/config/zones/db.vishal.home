$TTL    604800
@   IN  SOA  ns1.vishal.home. admin.vishal.home. (
        2025092805 ; serial
        3600       ; refresh
        1800       ; retry
        604800     ; expire
        86400 )    ; minimum
;
@       IN      NS      ns1.vishal.home.
ns1     IN      A       192.168.1.167
; teable on Tailscale
teable  IN  A  100.112.87.55
; Examples - replace with the actual IPs used by your lab/VMs/containers
vm1     IN      A       192.168.1.10
vm2     IN      A       192.168.1.11
docker1 IN      A       192.168.1.20
; internal production host
srv-prod-1      IN      A       192.168.1.172
srv-prod1       IN      CNAME   srv-prod-1
; Tailscale reachable host example (if you want to use the host's private IP via tailscale mapping)
; host-tailscale IN  A   100.101.102.103
win11           IN       A          100.121.198.110
windows11       IN       CNAME      win11
